        <a class="link-card" href="https://www.tiktok.com/@mauiwow1e" data-placeholder="TikTok">
          <span class="link-icon">♪</span><span class="link-copy"><span class="link-title">TIKTOK</span><span class="link-sub"> Clips dan Live</span></span><span class="arrow">↗</span>
