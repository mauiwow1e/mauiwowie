  <div class="toast" id="toast" role="status" aria-live="polite"></div>
  <script>
    document.getElementById('year').textContent = new Date().getFullYear();
    const toast = document.getElementById('toast');
    let toastTimer;
    function showToast(message) {
      toast.textContent = message;
      toast.classList.add('show');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toast.classList.remove('show'), 2400);
    }
    document.querySelectorAll('[data-placeholder]').forEach(link => {
      link.addEventListener('click', event => {
        if (link.getAttribute('href') === '#') {
          event.preventDefault();
          showToast('Tautan ' + link.dataset.placeholder + ' belum diatur. Edit href di index.html.');
        }
      });
    });
    document.getElementById('copyBtn').addEventListener('click', async () => {
      const code = document.getElementById('promoCode').textContent.trim();
      const status = document.getElementById('copyStatus');
      try {
        await navigator.clipboard.writeText(code);
        status.textContent = 'Kode berhasil disalin!';
        showToast('Kode promo disalin: ' + code);
      } catch (error) {
        const field = document.createElement('textarea');
        field.value = code;
        field.setAttribute('readonly', '');
        field.style.position = 'absolute';
        field.style.left = '-9999px';
        document.body.appendChild(field);
        field.select();
        const copied = document.execCommand('copy');
        field.remove();
        status.textContent = copied ? 'Kode berhasil disalin!' : 'Salin kode secara manual: ' + code;
        showToast(copied ? 'Kode promo disalin: ' + code : 'Silakan salin kode secara manual.');
      }
    });
  </script>
